# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # (vecchio nome: ANON_KEY, ancora accettato)
SUPABASE_SERVICE_ROLE_KEY=      # "secret key" sb_secret_… (o service_role): solo server, mai nel client

# Stripe (dietro lib/payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opzionali: di norma i prezzi si trovano da soli via lookup_key (npm run stripe:setup)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_PASS=
PAYMENT_PROVIDER=stripe

# Sito
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pipeline contenuti (solo offline)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
