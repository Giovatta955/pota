{
  "name": "pota",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts",
    "generate": "tsx --env-file-if-exists=.env.local scripts/generate.ts",
    "validate": "tsx --env-file-if-exists=.env.local scripts/validate.ts",
    "review": "tsx --env-file-if-exists=.env.local scripts/review.ts",
    "import": "tsx --env-file-if-exists=.env.local scripts/import.ts",
    "stripe:setup": "tsx --env-file-if-exists=.env.local scripts/stripe-setup.ts",
    "preflight": "tsx --env-file-if-exists=.env.local scripts/preflight.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "stripe": "^23.1.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.6",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
